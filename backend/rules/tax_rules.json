  {"rule_id": "TAX-004", "rule_name": "零申报风险提示", "risk_category": "税务风险", "risk_level": "低", "applicable_document_type": "tax_return", "condition": {"all": [{"field": "amount", "operator": "==", "value": 0}]}, "evidence_fields": ["amount", "date"], "suggestion_template": "存在零申报记录，请确认是否符合实际经营。", "manual_review_required": false, "priority": 40},
  {"rule_id": "TAX-005", "rule_name": "进项发票无税额", "risk_category": "税务风险", "risk_level": "中", "applicable_document_type": "invoice_list", "condition": {"all": [{"field": "tax_amount", "operator": "is_empty"}, {"field": "amount", "operator": ">=", "value": 1000}]}, "evidence_fields": ["invoice_number", "amount", "tax_amount"], "suggestion_template": "进项发票应关注税额及抵扣资格。", "manual_review_required": false, "priority": 60},
  {"rule_id": "TAX-006", "rule_name": "免税发票提示", "risk_category": "税务风险", "risk_level": "低", "applicable_document_type": "invoice_list", "condition": {"all": [{"field": "tax_rate", "operator": "contains", "value": "0"}]}, "evidence_fields": ["tax_rate", "amount"], "suggestion_template": "零税率/免税发票需核实适用政策。", "manual_review_required": true, "priority": 55},
  {"rule_id": "TAX-007", "rule_name": "代开发票风险", "risk_category": "税务风险", "risk_level": "高", "applicable_document_type": "invoice_list", "condition": {"all": [{"field": "summary", "operator": "contains", "value": "代开"}]}, "evidence_fields": ["summary", "amount"], "suggestion_template": "代开发票需关注税前扣除合规性。", "manual_review_required": true, "priority": 88},
  {"rule_id": "TAX-008", "rule_name": "跨年发票", "risk_category": "税务风险", "risk_level": "中", "applicable_document_type": "invoice_list", "condition": {"all": [{"field": "date", "operator": "is_not_empty"}]}, "evidence_fields": ["date", "invoice_number"], "suggestion_template": "请关注发票开票日期与入账期间是否匹配。", "manual_review_required": false, "priority": 50}
