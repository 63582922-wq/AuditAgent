  {"rule_id": "CTR-001", "rule_name": "合同金额为空", "risk_category": "合同风险", "risk_level": "高", "applicable_document_type": "contract", "condition": {"all": [{"field": "contract_amount", "operator": "is_empty"}]}, "evidence_fields": ["contract_no", "party_a", "party_b"], "suggestion_template": "合同未识别到金额，请人工确认合同正文。", "manual_review_required": true, "priority": 90},
  {"rule_id": "CTR-002", "rule_name": "合同主体不完整", "risk_category": "合同风险", "risk_level": "中", "applicable_document_type": "contract", "condition": {"all": [{"field": "party_a", "operator": "is_empty"}]}, "evidence_fields": ["party_a", "party_b"], "suggestion_template": "合同甲方信息缺失。", "manual_review_required": true, "priority": 70},
  {"rule_id": "CTR-003", "rule_name": "合同未约定发票类型", "risk_category": "合同风险", "risk_level": "中", "applicable_document_type": "contract", "condition": {"all": [{"field": "invoice_type", "operator": "is_empty"}, {"field": "contract_amount", "operator": ">=", "value": 10000}]}, "evidence_fields": ["contract_amount", "invoice_type"], "suggestion_template": "大额合同应明确发票类型（专票/普票）。", "manual_review_required": true, "priority": 75},
  {"rule_id": "CTR-004", "rule_name": "合同税率未约定", "risk_category": "合同风险", "risk_level": "低", "applicable_document_type": "contract", "condition": {"all": [{"field": "tax_rate", "operator": "is_empty"}, {"field": "contract_amount", "operator": ">=", "value": 50000}]}, "evidence_fields": ["contract_amount", "tax_rate"], "suggestion_template": "建议合同中明确适用税率。", "manual_review_required": false, "priority": 50},
  {"rule_id": "CTR-005", "rule_name": "超大额合同", "risk_category": "合同风险", "risk_level": "高", "applicable_document_type": "contract", "condition": {"all": [{"field": "contract_amount", "operator": ">=", "value": 1000000}]}, "evidence_fields": ["contract_amount", "party_b"], "suggestion_template": "超大额合同需重点核查审批流程及履约证据。", "manual_review_required": true, "priority": 95},
  {"rule_id": "CTR-006", "rule_name": "合同编号缺失", "risk_category": "合同风险", "risk_level": "中", "applicable_document_type": "contract", "condition": {"all": [{"field": "contract_no", "operator": "is_empty"}]}, "evidence_fields": ["contract_no"], "suggestion_template": "未识别到合同编号，不利于与发票、流水关联。", "manual_review_required": true, "priority": 65},
  {"rule_id": "CTR-007", "rule_name": "乙方信息缺失", "risk_category": "合同风险", "risk_level": "中", "applicable_document_type": "contract", "condition": {"all": [{"field": "party_b", "operator": "is_empty"}]}, "evidence_fields": ["party_b"], "suggestion_template": "合同乙方信息缺失。", "manual_review_required": true, "priority": 65},
  {"rule_id": "CTR-008", "rule_name": "合同金额较小但无发票类型", "risk_category": "合同风险", "risk_level": "低", "applicable_document_type": "contract", "condition": {"all": [{"field": "contract_amount", "operator": ">=", "value": 5000}, {"field": "invoice_type", "operator": "is_empty"}]}, "evidence_fields": ["contract_amount"], "suggestion_template": "建议补充发票类型约定。", "manual_review_required": false, "priority": 45}
