DATABASE_URL=postgresql+psycopg2://fxpg:fxpg@localhost:5432/fxpg
STORAGE_PATH=./storage
APP_ENV=development

# ========== 文本 Agent：DeepSeek ==========
LLM_API_KEY=你的-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

ENABLE_LLM=true

# ========== 视觉模型：GLM-OCR（智谱 layout_parsing）==========
VISION_API_KEY=你的-智谱-api-key
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VISION_MODEL=glm-ocr
VISION_MAX_WORKERS=3
VISION_HIGH_RISK_MIN_PASSES=2
VISION_INTER_REQUEST_DELAY_SEC=0.8

# PDF 图像页视觉检查上限；0 表示不限制页数
PDF_VISION_MAX_PAGES=120

# 生产必填；开发可留空（不校验）
API_KEY=

# 生产：前端公网地址，逗号分隔
# CORS_ORIGINS=https://fxpg-web.onrender.com

MAX_UPLOAD_MB=50
JOB_WORKERS=2
BOOTSTRAP_DATA_ON_STARTUP=false
SYNC_PGVECTOR_ON_STARTUP=false

# 业务域：compliance（会议合规观察，默认）| accounting（会计风险评估）
AGENT_DOMAIN=compliance
AGENT_EXECUTION_MODE=orchestrator
ENABLE_HUMAN_GATE=false
